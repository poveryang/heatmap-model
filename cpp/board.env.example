# 复制为 cpp/board.env 后按板端实际情况修改（board.env 已 gitignore，勿提交密码）
#
#   cp cpp/board.env.example cpp/board.env

BOARD_HOST=10.80.184.167
BOARD_SSH_PORT=201
BOARD_USER=root
# 留空则使用本机 SSH 密钥；填写后脚本通过 expect 自动输入（需 brew install expect）
BOARD_PASSWORD=

REMOTE_DIR=/tmp/heatmap-model

# 本地路径均相对仓库根目录
BINARY_PATH=cpp/build/imx8plus/HMAP-TEST
MODEL_PATH=cpp/artifacts/tmfile/model-uint8.tmfile
IMAGE_PATH=
OUT_DIR=cpp/artifacts/imx8plus

OPENCV_RUNTIME_DIR=cpp/build/imx8plus/runtime/opencv
GCC_RUNTIME_DIR=cpp/build/imx8plus/runtime/gcc
# none = 用板端 /usr/lib/libtengine-lite.so（推荐 timvx）；minimal = 仅上传本地 libtengine-lite.so
TENGINE_RUNTIME_MODE=none

# timvx = NPU (TIM-VX)；cpu = 纯 CPU 回退
CONTEXT=timvx
PRECISION=uint8
