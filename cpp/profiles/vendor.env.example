# Template for future vendor-provided Docker conversion environments.

MODEL_CONVERT_ID=vendor-platform
MODEL_CONVERT_TARGET=vendor-device
MODEL_CONVERT_MODEL_FORMAT=vendor-format
MODEL_CONVERT_RUNNER=docker

MODEL_CONVERT_DOCKER_IMAGE=vendor/model-tools:latest
MODEL_CONVERT_DOCKER_PLATFORM=""
MODEL_CONVERT_DOCKER_WORKDIR=/workspace
MODEL_CONVERT_DOCKER_ARGS=""

# Platform-specific wrappers can define their own commands while still sharing
# the common profile fields above.
VENDOR_CONVERT_CMD=/opt/vendor/bin/convert_model
VENDOR_QUANT_CMD=/opt/vendor/bin/quant_model

DEFAULT_ONNX_PATH="cpp/artifacts/onnx/hmap-v2.onnx"
DEFAULT_FP32_MODEL="cpp/artifacts/vendor/hmap-v2-fp32.model"
DEFAULT_QUANT_MODEL="cpp/artifacts/vendor/hmap-v2-quant.model"
DEFAULT_CALIB_DATASET=""
