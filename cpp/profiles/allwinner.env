MODEL_CONVERT_ID=allwinner
MODEL_CONVERT_TARGET=allwinner
MODEL_CONVERT_MODEL_FORMAT=vendor-specific
MODEL_CONVERT_RUNNER=docker

MODEL_CONVERT_DOCKER_SOURCE_IMAGE="${MODEL_CONVERT_DOCKER_SOURCE_IMAGE:-git.smoa.cc:5050/x-barcode/barcode-sdk/allwinner_model_convert:v1.0}"
MODEL_CONVERT_DOCKER_IMAGE="${MODEL_CONVERT_DOCKER_IMAGE:-model-convert-tool:allwinner}"
MODEL_CONVERT_DOCKER_WORKDIR="${MODEL_CONVERT_DOCKER_WORKDIR:-/workspace}"
MODEL_CONVERT_DOCKER_ARGS="${MODEL_CONVERT_DOCKER_ARGS:-}"
MODEL_CONVERT_DOCKER_CALIB_DIR="${MODEL_CONVERT_DOCKER_CALIB_DIR:-/calib}"

DEFAULT_ONNX_PATH="${DEFAULT_ONNX_PATH:-cpp/artifacts/onnx/hmap-v2.onnx}"
DEFAULT_FP32_MODEL="${DEFAULT_FP32_MODEL:-cpp/artifacts/allwinner/hmap-v2-fp32.model}"
DEFAULT_QUANT_MODEL="${DEFAULT_QUANT_MODEL:-cpp/artifacts/allwinner/hmap-v2-quant.model}"
DEFAULT_CALIB_DATASET="${DEFAULT_CALIB_DATASET:-}"

# Fill these after inspecting the vendor image CLI.
VENDOR_CONVERT_CMD="${VENDOR_CONVERT_CMD:-}"
VENDOR_QUANT_CMD="${VENDOR_QUANT_CMD:-}"
