MODEL_CONVERT_ID=imx8plus
MODEL_CONVERT_TARGET=imx8plus
MODEL_CONVERT_MODEL_FORMAT=tmfile
MODEL_CONVERT_RUNNER=docker

MODEL_CONVERT_DOCKER_IMAGE="${MODEL_CONVERT_DOCKER_IMAGE:-model-convert-tool:imx8plus}"
MODEL_CONVERT_DOCKER_PLATFORM="${MODEL_CONVERT_DOCKER_PLATFORM:-linux/amd64}"
MODEL_CONVERT_DOCKER_WORKDIR="${MODEL_CONVERT_DOCKER_WORKDIR:-/workspace}"
MODEL_CONVERT_DOCKER_ARGS="${MODEL_CONVERT_DOCKER_ARGS:-}"
MODEL_CONVERT_DOCKER_CALIB_DIR="${MODEL_CONVERT_DOCKER_CALIB_DIR:-/calib}"

TENGINE_CONVERT_TOOL="${TENGINE_CONVERT_TOOL:-/opt/tengine/build/install/bin/convert_tool}"
TENGINE_QUANT_TOOL="${TENGINE_QUANT_TOOL:-/opt/tengine/build/install/bin/quant_tool_uint8}"

# 中间产物默认写入 cpp/artifacts/
DEFAULT_FP32_TMFILE="${DEFAULT_FP32_TMFILE:-cpp/artifacts/tmfile/model-fp32.tmfile}"
DEFAULT_UINT8_TMFILE="${DEFAULT_UINT8_TMFILE:-cpp/artifacts/tmfile/model-uint8.tmfile}"

TENGINE_INPUT_SHAPE="${TENGINE_INPUT_SHAPE:-1,400,640}"
TENGINE_MEAN_VALUES="${TENGINE_MEAN_VALUES:-110.4,110.4,110.4}"
TENGINE_SCALE_VALUES="${TENGINE_SCALE_VALUES:-0.2349,0.2349,0.2349}"
TENGINE_QUANT_THREADS="${TENGINE_QUANT_THREADS:-64}"
TENGINE_QUANT_ALGORITHM="${TENGINE_QUANT_ALGORITHM:-1}"
